# مسیر پایگاه‌داده SQLite. برای اجرای محلی همین مقدار مناسب است.
DATABASE_PATH=./.data/daftar-setareh.db

# یک رشته تصادفی و طولانی (حداقل ۳۲ کاراکتر). هرگز آن را در مخزن قرار ندهید.
AUTH_SECRET=replace-with-a-long-random-secret

# آدرس عمومی برنامه. برای اجرای محلی لازم نیست.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# فقط برای انتشار واقعی، origin دامنه را پیش از build تنظیم کنید؛ بدون مسیر یا پارامتر.
# در لوکال پورت واقعی درخواست استفاده می‌شود و تنظیم این مورد لازم نیست.
# SITE_URL=https://your-real-domain.example

# پیکربندی پیامک: console | kavenegar | none
# console فقط در محیط توسعه کد تأیید را در ترمینال نشان می‌دهد و پیامک واقعی نمی‌فرستد.
SMS_PROVIDER=console

# برای کاوه‌نگار این دو مقدار را تنظیم کنید.
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ورود سریع به حساب نمایشی (داده‌های نمونه). پیش‌فرض غیرفعال است.
DEMO_MODE=false

# کلید امنیتی برای اجرای زمان‌بندی ساخت کارنامه‌ها.
CRON_SECRET=
